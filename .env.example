# Data source switch — flip to "graphql" once WordPress/WooCommerce/WPGraphQL
# is live. This should be the ONLY change needed to go from mock to live data.
NEXT_PUBLIC_DATA_SOURCE=mock

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future WPGraphQL endpoint (WordPress + WooGraphQL + WPGraphQL for Yoast SEO)
# NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://cms.example.com/graphql
# WOOCOMMERCE_SESSION_SECRET=

# Google Tag Manager — leave unset locally; GTMProvider/AnalyticsProvider
# stay fully inert without it.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
