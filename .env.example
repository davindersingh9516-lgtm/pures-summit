# Data source switch — flip to "graphql" once WordPress/WooCommerce/WPGraphQL
# is live. This should be the ONLY change needed to go from mock to live data.
NEXT_PUBLIC_DATA_SOURCE=mock

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WPGraphQL endpoint (WordPress + WooGraphQL + WPGraphQL for Yoast SEO + WPGraphQL for ACF)
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=http://localhost/pure-summit/graphql
# WOOCOMMERCE_SESSION_SECRET=

NEXT_PUBLIC_STORE_CURRENCY=NZD

# Stripe — leave blank locally until real test keys are available.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret WordPress sends to /api/revalidate on content changes.
# REVALIDATE_SECRET=

# Google Tag Manager — leave unset locally; GTMProvider/AnalyticsProvider
# stay fully inert without it.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
